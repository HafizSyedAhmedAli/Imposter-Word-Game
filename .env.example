NEXT_PUBLIC_API_BASE_URL=https://imposter-word-game-drab.vercel.app
GEMINI_API_KEY=

# PostHog custom-events analytics (see lib/analytics.ts). Get the key
# from your PostHog project settings. Host: https://us.i.posthog.com for
# US cloud, https://eu.i.posthog.com for EU cloud, or your self-hosted
# instance's URL. If NEXT_PUBLIC_POSTHOG_KEY is unset, analytics is
# silently disabled (no crash, no console spam).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com