# Only needed in .env.mobile 
NEXT_PUBLIC_API_BASE_URL=https://imposter-word-game-drab.vercel.app

GEMINI_API_KEY=

# PostHog custom-events analytics (see lib/analytics.ts). Get the key
# from your PostHog project settings. Host: https://us.i.posthog.com for
# US cloud, https://eu.i.posthog.com for EU cloud, or your self-hosted
# instance's URL. If NEXT_PUBLIC_POSTHOG_KEY is unset, analytics is
# silently disabled (no crash, no console spam).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error monitoring (see lib/monitoring.ts, instrumentation-client.ts,
# sentry.server.config.ts). If NEXT_PUBLIC_SENTRY_DSN is unset, Sentry stays
# fully inactive -- no init, no requests, no effect on the app or the build.
# Public DSN from your Sentry project settings (Settings -> Client Keys).
NEXT_PUBLIC_SENTRY_DSN=
# Org/project slugs, used only at build time to upload source maps.
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token for source-map upload during `next build`/`build:mobile`.
# SERVER-ONLY -- never prefix with NEXT_PUBLIC_, never exposed to the
# browser. Create one at https://sentry.io/settings/account/api/auth-tokens/
# with the `project:releases` scope. Without it, builds still succeed;
# source maps are just not uploaded, so stack traces show minified code.
SENTRY_AUTH_TOKEN=
# Optional: 0.0-1.0. Performance tracing is off (0) by default -- see
# next.config.ts / instrumentation-client.ts's doc comments for why.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0