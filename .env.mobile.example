# Used only by `npm run build:mobile` (scripts/build-mobile.mjs). The
# native app ships with no server of its own, so it needs the absolute
# URL of a deployed instance that still runs `next build`/`next start`
# normally, keeping app/api/round/generate server-side there.
NEXT_PUBLIC_API_BASE_URL=https://imposter-word-game-drab.vercel.app